---
import Layout from '../layouts/Layout.astro';

const tools = [
  {
    version: 'V0.4.2',
    type: 'SECRET SCANNER',
    name: 'poltergeist',
    description: "Ghost Security Agent's secret scanner. It scans source code for leaked API keys, tokens, certificates, and credentials using a dual-engine architecture that combines speed with precision.",
    command: '/ghost-scan-secrets',
    tagColor: '#1D4ED8',
    shaderShape: 5,
    shaderColor: [0.114, 0.306, 0.847, 1],
  },
  {
    version: 'V0.3.1',
    type: 'DEPENDENCY SCANNER',
    name: 'wraith',
    description: "Ghost Security Agent's dependency scanner. It scans lockfiles for known vulnerabilities using the OSV database, supporting every major package ecosystem with offline mode and license scanning.",
    command: '/ghost-scan-deps',
    tagColor: '#6D28D9',
    shaderShape: 6,
    shaderColor: [0.427, 0.157, 0.851, 1],
  },
  {
    version: 'V0.2.8',
    type: 'MITM PROXY',
    name: 'reaper',
    description: "Ghost Security Agent's MITM HTTPS proxy. It intercepts in-scope traffic, stores full request/response pairs in a local SQLite database, and provides a CLI for searching and inspecting captured data.",
    command: '/ghost-intercept',
    tagColor: '#BE123C',
    shaderShape: 2,
    shaderColor: [0.745, 0.071, 0.235, 1],
  },
  {
    version: 'V0.1.5',
    type: 'CODE ANALYSIS',
    name: 'exorcist',
    description: "Ghost Security Agent's code analysis engine. It reads code like a security engineer: planning attack vectors, tracing data flows, checking for mitigations, and verifying findings independently.",
    command: '/ghost-analyze',
    tagColor: '#047857',
    shaderShape: 4,
    shaderColor: [0.016, 0.471, 0.341, 1],
  },
];

const typeClassMap: Record<string, string> = {
  'BOLA': 'vuln-tag--bola',
  'SQL Injection': 'vuln-tag--sqli',
  'Command Injection': 'vuln-tag--cmdi',
  'Stored XSS': 'vuln-tag--xss',
  'Auth Session Expiry': 'vuln-tag--auth',
  'TOCTOU': 'vuln-tag--toctou',
};

const vulnerabilities = [
  { date: 'Mar. 2026', id: 'GSR-2026-03-004', type: 'BOLA', project: '[redacted] community platform', lang: 'Ruby' },
  { date: 'Mar. 2026', id: 'GSR-2026-03-003', type: 'SQL Injection', project: '[redacted] CMS platform', lang: 'Python' },
  { date: 'Mar. 2026', id: 'GSR-2026-03-002', type: 'Command Injection', project: '[redacted] CMS platform', lang: 'Python' },
  { date: 'Mar. 2026', id: 'GSR-2026-03-001', type: 'BOLA', project: '[redacted] operations platform', lang: 'Ruby' },
  { date: 'Feb. 2026', id: 'GSR-2026-02-007', type: 'Stored XSS', project: '[redacted] CMS platform', lang: 'JavaScript' },
  { date: 'Feb. 2026', id: 'GSR-2026-02-006', type: 'Auth Session Expiry', project: '[redacted] database', lang: 'Ruby' },
  { date: 'Feb. 2026', id: 'GSR-2026-02-005', type: 'BOLA', project: '[redacted] vuln mgmt platform', lang: 'Ruby' },
  { date: 'Feb. 2026', id: 'GSR-2026-02-004', type: 'BOLA', project: '[redacted] vuln mgmt platform', lang: 'Ruby' },
  { date: 'Feb. 2026', id: 'GSR-2026-02-003', type: 'Command Injection', project: 'NPM package manager', lang: 'JavaScript' },
  { date: 'Feb. 2026', id: 'GSR-2026-02-002', type: 'TOCTOU', project: '[redacted] commerce platform', lang: 'Python' },
  { date: 'Feb. 2026', id: 'GSR-2026-02-001', type: 'TOCTOU', project: '[redacted] commerce platform', lang: 'TypeScript' },
];
---

<Layout>
  <!-- Navigation -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-border">
    <nav class="max-w-7xl mx-auto flex items-center h-14 px-4 lg:px-8">
      <a href="#" class="flex items-center mr-8">
        <span class="font-bold text-lg tracking-tight">ghost</span>
      </a>
      <div class="hidden md:flex items-center gap-1">
        <a href="#research" class="nav-link">[R] RESEARCH</a>
        <a href="#tools" class="nav-link">[T] TOOLS</a>
        <a href="#about" class="nav-link">[A] ABOUT</a>
        <a href="https://github.com/" target="_blank" rel="noopener" class="nav-link">[G] GITHUB</a>
      </div>
      <a href="https://app.ghostsecurity.ai/?t=w" class="hidden md:flex ml-auto nav-link">[C] LOGIN</a>
      <button id="mobile-menu-btn" class="md:hidden ml-auto flex items-center justify-center w-8 h-8" aria-label="Menu">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
          <line x1="2" y1="4" x2="14" y2="4" /><line x1="2" y1="8" x2="14" y2="8" /><line x1="2" y1="12" x2="14" y2="12" />
        </svg>
      </button>
    </nav>
    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-border bg-white px-4 pb-4">
      <a href="#research" class="block py-2 nav-link">[R] RESEARCH</a>
      <a href="#tools" class="block py-2 nav-link">[T] TOOLS</a>
      <a href="#about" class="block py-2 nav-link">[A] ABOUT</a>
      <a href="https://github.com/" target="_blank" rel="noopener" class="block py-2 nav-link">[G] GITHUB</a>
      <a href="https://app.ghostsecurity.ai/?t=w" class="block py-2 nav-link">[C] LOGIN</a>
    </div>
  </header>

  <main>
    <!-- Hero Section -->
    <section class="pt-14 flex flex-col relative">
      <!-- Hero dithering shader -->
      <div id="gs-hero-shader" class="absolute inset-0 z-0 pointer-events-none opacity-40 mix-blend-multiply"></div>
      <div class="absolute inset-0 z-[1] pointer-events-none bg-gradient-to-r from-white via-white/85 via-25% to-transparent to-55%"></div>

      <div class="relative z-10 max-w-7xl mx-auto px-4 lg:px-8 pt-20 pb-16 lg:pt-28 lg:pb-20">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
          <!-- Left: Text content -->
          <div>
            <p class="font-mono text-xs uppercase tracking-[0.15em] text-muted mb-6">Frontier Security Lab</p>
            <h1 class="text-5xl md:text-6xl lg:text-5xl xl:text-7xl font-light tracking-tight leading-[1.05] mb-8">
              Agentic AppSec Research for All Humankind.
            </h1>
            <p class="text-base lg:text-lg text-muted leading-relaxed max-w-xl mb-8">
              Ghost Security builds autonomous agents and open source tools for security research. We discover, analyze, and responsibly disclose vulnerabilities at scale.
            </p>
            <a href="/vulnbench" class="inline-flex items-center gap-2 bg-foreground text-white font-mono text-xs uppercase tracking-[0.1em] px-5 py-3 rounded-sm hover:bg-neutral-800 transition-colors">
              View VulnBench Report <span class="text-lg leading-none">&rarr;</span>
            </a>
          </div>

          <!-- Right: Quick Start terminal (dark) -->
          <div class="gs-qs bg-[#0a0a0a] border border-white/10 rounded-[5px] overflow-hidden font-mono text-sm">
            <div class="flex items-center gap-1.5 px-3 py-2 border-b border-white/10">
              <span class="text-[10px] tracking-[0.2em] uppercase text-white/50 mr-1 shrink-0">Quick Start</span>
              <button class="qs-tab active" data-tab="cli">CLI</button>
              <button class="qs-tab" data-tab="claude-code">Claude Code</button>
              <button class="qs-tab" data-tab="manual">Manual</button>
            </div>
            <!-- CLI tab -->
            <div id="gs-qs-cli">
              <div class="p-4">
                <p class="text-[10px] tracking-[0.15em] uppercase text-white/50 mb-2">Install</p>
                <div class="qs-line"><span class="qs-prompt">$</span><span class="qs-cmd">claude plugin marketplace add ghostsecurity/skills</span></div>
                <div class="qs-line"><span class="qs-prompt">$</span><span class="qs-cmd">claude plugin install ghost@ghost-security</span></div>
              </div>
              <div class="p-4 border-t border-white/10">
                <p class="text-[10px] tracking-[0.15em] uppercase text-white/50 mb-2">Run</p>
                <div class="qs-line"><span class="qs-prompt">$</span><span class="qs-cmd qs-cmd--green">/ghost-scan-secrets</span></div>
                <div class="qs-line"><span class="qs-prompt">$</span><span class="qs-cmd qs-cmd--green">/ghost-scan-deps</span></div>
                <div class="qs-line"><span class="qs-prompt">$</span><span class="qs-cmd qs-cmd--green">/ghost-scan-code</span></div>
                <div class="qs-line"><span class="qs-prompt">$</span><span class="qs-cmd qs-cmd--green">/ghost-validate</span></div>
              </div>
            </div>
            <!-- Claude Code tab -->
            <div id="gs-qs-claude-code" style="display:none">
              <div class="p-4">
                <p class="text-[10px] tracking-[0.15em] uppercase text-white/50 mb-2">Install</p>
                <div class="qs-line"><span class="qs-prompt">$</span><span class="qs-cmd">/plugin marketplace add ghostsecurity/skills</span></div>
                <div class="qs-line"><span class="qs-prompt">$</span><span class="qs-cmd">/plugin install ghost@ghost-security</span></div>
              </div>
              <div class="p-4 border-t border-white/10">
                <p class="text-[10px] tracking-[0.15em] uppercase text-white/50 mb-2">Run</p>
                <div class="qs-line"><span class="qs-prompt">$</span><span class="qs-cmd qs-cmd--green">/ghost-scan-secrets</span></div>
                <div class="qs-line"><span class="qs-prompt">$</span><span class="qs-cmd qs-cmd--green">/ghost-scan-deps</span></div>
                <div class="qs-line"><span class="qs-prompt">$</span><span class="qs-cmd qs-cmd--green">/ghost-scan-code</span></div>
                <div class="qs-line"><span class="qs-prompt">$</span><span class="qs-cmd qs-cmd--green">/ghost-validate</span></div>
              </div>
            </div>
            <!-- Manual tab -->
            <div id="gs-qs-manual" style="display:none">
              <div class="p-4">
                <p class="text-[10px] tracking-[0.15em] uppercase text-white/50 mb-2">Install</p>
                <div class="qs-line"><span class="qs-prompt">$</span><span class="qs-cmd">git clone https://github.com/ghostsecurity/skills.git ~/.ghost/skills</span></div>
                <div class="qs-line"><span class="qs-prompt">$</span><span class="qs-cmd">claude --plugin-dir ~/.ghost/skills</span></div>
              </div>
              <div class="p-4 border-t border-white/10">
                <p class="text-[10px] tracking-[0.15em] uppercase text-white/50 mb-2">Run</p>
                <div class="qs-line"><span class="qs-prompt">$</span><span class="qs-cmd qs-cmd--green">/ghost-scan-secrets</span></div>
                <div class="qs-line"><span class="qs-prompt">$</span><span class="qs-cmd qs-cmd--green">/ghost-scan-deps</span></div>
                <div class="qs-line"><span class="qs-prompt">$</span><span class="qs-cmd qs-cmd--green">/ghost-scan-code</span></div>
                <div class="qs-line"><span class="qs-prompt">$</span><span class="qs-cmd qs-cmd--green">/ghost-validate</span></div>
              </div>
            </div>
            <div class="border-t border-white/10 px-4 py-2.5 flex items-center justify-between">
              <span class="text-[10px] text-white/50">Requires Claude Code v2.1.38+</span>
              <a href="#" class="text-[10px] text-white/50 hover:text-white/80 no-underline">Full docs &rarr;</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Stats bar -->
      <div class="border-y border-border relative z-10 dot-matrix-bg">
        <div class="max-w-7xl mx-auto px-4 lg:px-8 grid grid-cols-2 md:grid-cols-4">
          <div class="py-8 px-4 border-r border-border">
            <p class="text-3xl lg:text-4xl font-light tracking-tight">11+</p>
            <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-muted mt-1">CVEs Disclosed</p>
          </div>
          <div class="py-8 px-4 border-r border-border">
            <p class="text-3xl lg:text-4xl font-light tracking-tight">4</p>
            <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-muted mt-1">Languages</p>
          </div>
          <div class="py-8 px-4 border-r border-border">
            <p class="text-3xl lg:text-4xl font-light tracking-tight">6</p>
            <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-muted mt-1">Vuln Classes</p>
          </div>
          <div class="py-8 px-4">
            <p class="text-3xl lg:text-4xl font-light tracking-tight">2026</p>
            <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-muted mt-1">Since</p>
          </div>
        </div>
      </div>
    </section>

    <!-- About / Word Reveal Section -->
    <section id="about" class="relative py-[15vh] md:py-[20vh] overflow-hidden bg-neutral-950">
      <!-- Edge shader decorations -->
      <div id="gs-about-left" class="absolute left-0 inset-y-0 w-[200px] pointer-events-none" style="mask-image:linear-gradient(to right,rgba(0,0,0,1) 0%,rgba(0,0,0,0) 100%);-webkit-mask-image:linear-gradient(to right,rgba(0,0,0,1) 0%,rgba(0,0,0,0) 100%)"></div>
      <div id="gs-about-right" class="absolute right-0 inset-y-0 w-[200px] pointer-events-none" style="mask-image:linear-gradient(to left,rgba(0,0,0,1) 0%,rgba(0,0,0,0) 100%);-webkit-mask-image:linear-gradient(to left,rgba(0,0,0,1) 0%,rgba(0,0,0,0) 100%)"></div>
      <div class="relative z-10 max-w-4xl mx-auto px-6 flex items-center justify-center min-h-[20vh]">
        <p id="gs-about-text" class="text-2xl md:text-4xl lg:text-5xl font-light tracking-tight text-white text-center leading-relaxed">
          We're an expert team building autonomous agents at the frontier of security research, finding vulnerabilities at supernatural scale.
        </p>
      </div>
    </section>

    <!-- Tools Section -->
    <section id="tools" class="border-b border-border">
      <div class="max-w-7xl mx-auto px-4 lg:px-8 py-16 lg:py-24">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-12">
          <div>
            <p class="font-mono text-xs uppercase tracking-[0.15em] text-muted mb-3">Tools</p>
            <h2 class="text-3xl lg:text-4xl font-light tracking-tight">Agent skills & open source tools.</h2>
          </div>
          <a href="https://github.com/" target="_blank" rel="noopener" class="inline-flex items-center gap-2 mt-4 md:mt-0 font-mono text-xs uppercase tracking-[0.1em] text-foreground hover:underline">
            View on GitHub <span class="text-lg leading-none">&rarr;</span>
          </a>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          {tools.map((tool) => (
            <div class="gs-tool border border-border rounded-lg overflow-hidden hover:border-neutral-400 transition-colors bg-white">
              <div class="relative w-full h-[160px] overflow-hidden bg-white">
                <div class="gs-tool__shader absolute inset-0 opacity-10 transition-opacity duration-500" id={`gs-shader-${tool.name}`}
                  data-shape={tool.shaderShape}
                  data-color={JSON.stringify(tool.shaderColor)}></div>
                <div class="absolute top-3 right-3 font-mono text-[9px] text-muted/30 uppercase tracking-[0.1em]">{tool.version}</div>
              </div>
              <div class="p-5">
                <span class="font-mono text-[10px] uppercase tracking-[0.2em] block mb-1.5" style={`color: ${tool.tagColor}`}>&#9642; {tool.type}</span>
                <h3 class="font-mono text-lg font-medium tracking-tight mb-2">{tool.name}</h3>
                <p class="text-sm text-muted leading-relaxed mb-4">{tool.description}</p>
              </div>
              <div class="border-t border-border px-5 py-3">
                <div class="flex items-center gap-2 bg-accent rounded px-3 py-2">
                  <span class="text-muted font-mono text-sm">&gt;</span>
                  <code class="font-mono text-sm">{tool.command}</code>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ASCII Transition -->
    <section class="relative overflow-hidden border-b border-white/[0.06] bg-neutral-950 text-white/10 py-8 font-mono text-xs leading-relaxed overflow-x-hidden">
      <div class="px-4">
        <p class="whitespace-nowrap overflow-hidden">{'░'.repeat(200)}</p>
        <p class="whitespace-nowrap overflow-hidden">{'▒'.repeat(200)}</p>
        <p class="whitespace-nowrap overflow-hidden">{'▓'.repeat(200)}</p>
        <p class="whitespace-nowrap overflow-hidden">{'░'.repeat(200)}</p>
        <p class="whitespace-nowrap overflow-hidden">{'▒'.repeat(200)}</p>
      </div>
    </section>

    <!-- VulnBench Section -->
    <section class="bg-neutral-950 text-white relative overflow-hidden">
      <div id="gs-cta-shader" class="absolute inset-0 z-0 pointer-events-none opacity-[0.08]"></div>
      <div class="max-w-7xl mx-auto px-4 lg:px-8 py-16 lg:py-24 relative z-10">
        <p class="font-mono text-xs uppercase tracking-[0.15em] text-white/40 mb-3">VulnBench</p>
        <h2 class="text-3xl lg:text-4xl font-light tracking-tight text-white mb-3">
          VulnBench: Measuring AI Security Skill.
        </h2>
        <p class="text-base text-white/60 leading-relaxed max-w-2xl mb-8">
          Our open research benchmark evaluates how well AI models discover real-world security vulnerabilities across diverse codebases and attack surfaces.
        </p>
        <a href="/vulnbench" class="inline-flex items-center gap-2 bg-white text-black font-mono text-xs uppercase tracking-[0.1em] px-5 py-3 rounded-sm hover:bg-white/90 transition-colors">
          View Report <span class="text-lg leading-none">&rarr;</span>
        </a>
      </div>
    </section>

    <!-- Dashed Line Transition -->
    <section class="border-b border-border relative overflow-hidden py-6 text-neutral-200 font-mono text-xs leading-loose">
      <div class="px-4 space-y-1">
        <p class="whitespace-nowrap overflow-hidden">{'─ '.repeat(175)}</p>
        <p class="whitespace-nowrap overflow-hidden">{'─ '.repeat(175)}</p>
        <p class="whitespace-nowrap overflow-hidden">{'─ '.repeat(175)}</p>
        <p class="whitespace-nowrap overflow-hidden">{'─ '.repeat(175)}</p>
      </div>
    </section>

    <!-- Research Section -->
    <section id="research" class="border-b border-border">
      <div class="max-w-7xl mx-auto px-6">
        <div class="py-12 border-b border-border max-w-3xl">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted mb-3">Research</p>
          <h2 class="text-3xl lg:text-4xl font-light tracking-tight mb-3">Recent vulnerability disclosures.</h2>
          <p class="text-sm text-muted leading-relaxed">
            The Ghost Security Research team has discovered and disclosed a number of vulnerabilities using Ghost Security Agent Skills. All findings are responsibly disclosed to maintainers prior to publication.
          </p>
        </div>

        <!-- Interactive 2-column: table + detail panel -->
        <div class="grid grid-cols-1 lg:grid-cols-[2fr_1fr] border-b border-border">
          <div class="border-r border-border overflow-x-auto" id="gs-research-table">
            <table class="w-full text-sm border-collapse">
              <thead>
                <tr>
                  <th class="text-left font-mono text-xs uppercase tracking-[0.1em] text-muted font-normal p-4 border-b border-border">Discovered</th>
                  <th class="text-left font-mono text-xs uppercase tracking-[0.1em] text-muted font-normal p-4 border-b border-border">Vulnerability</th>
                  <th class="text-left font-mono text-xs uppercase tracking-[0.1em] text-muted font-normal p-4 border-b border-border">Type</th>
                  <th class="text-left font-mono text-xs uppercase tracking-[0.1em] text-muted font-normal p-4 border-b border-border">Project</th>
                  <th class="text-left font-mono text-xs uppercase tracking-[0.1em] text-muted font-normal p-4 border-b border-border">Lang</th>
                </tr>
              </thead>
              <tbody>
                {vulnerabilities.map((vuln, i) => (
                  <tr class="research-row cursor-pointer transition-colors" data-idx={i}>
                    <td class="p-4 border-b border-border font-mono text-xs text-muted whitespace-nowrap">{vuln.date}</td>
                    <td class="p-4 border-b border-border font-mono text-xs">{vuln.id}</td>
                    <td class="p-4 border-b border-border">
                      <span class={`vuln-tag ${typeClassMap[vuln.type] || ''}`}>{vuln.type}</span>
                    </td>
                    <td class="p-4 border-b border-border text-xs text-muted max-w-[200px] overflow-hidden text-ellipsis whitespace-nowrap">{vuln.project}</td>
                    <td class="p-4 border-b border-border text-xs">{vuln.lang}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="research-panel p-8 flex flex-col h-full transition-colors" id="gs-research-panel">
            <div class="flex-1" id="gs-research-panel-content"></div>
            <div class="pt-6 border-t border-border mt-auto">
              <p class="font-mono text-xs uppercase tracking-[0.15em] text-muted mb-3">Disclosure Policy</p>
              <p class="text-xs text-muted leading-relaxed">Ghost Security follows a 90-day responsible disclosure policy. All vulnerabilities are privately reported to maintainers and given adequate time for remediation before public disclosure.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-border bg-white">
    <div class="max-w-7xl mx-auto px-4 lg:px-8 py-12 lg:py-16">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-12">
        <div>
          <p class="font-bold text-sm mb-1">GHOST SECURITY</p>
          <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-muted">Frontier Security Lab</p>
        </div>

        <div>
          <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-muted mb-4">Research</p>
          <ul class="space-y-2">
            <li><a href="#research" class="text-sm text-muted hover:text-foreground transition-colors">Vulnerability Disclosures</a></li>
            <li><a href="#research" class="text-sm text-muted hover:text-foreground transition-colors">CVE Database</a></li>
            <li><a href="#research" class="text-sm text-muted hover:text-foreground transition-colors">Security Advisories</a></li>
            <li><a href="#research" class="text-sm text-muted hover:text-foreground transition-colors">Research Blog</a></li>
          </ul>
        </div>

        <div>
          <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-muted mb-4">Tools</p>
          <ul class="space-y-2">
            <li><a href="#tools" class="text-sm text-muted hover:text-foreground transition-colors">poltergeist</a></li>
            <li><a href="#tools" class="text-sm text-muted hover:text-foreground transition-colors">wraith</a></li>
            <li><a href="#tools" class="text-sm text-muted hover:text-foreground transition-colors">reaper</a></li>
            <li><a href="#tools" class="text-sm text-muted hover:text-foreground transition-colors">exorcist</a></li>
          </ul>
        </div>

        <div>
          <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-muted mb-4">Connect</p>
          <ul class="space-y-2">
            <li><a href="https://github.com/" target="_blank" rel="noopener" class="text-sm text-muted hover:text-foreground transition-colors">GitHub</a></li>
            <li><a href="#" class="text-sm text-muted hover:text-foreground transition-colors">Security Contact</a></li>
            <li><a href="#" class="text-sm text-muted hover:text-foreground transition-colors">CVD Policy</a></li>
            <li><a href="#" class="text-sm text-muted hover:text-foreground transition-colors">PGP Key</a></li>
          </ul>
        </div>
      </div>

      <div class="border-t border-border pt-6 flex flex-col md:flex-row md:items-center md:justify-between gap-2">
        <p class="font-mono text-[10px] uppercase tracking-[0.1em] text-muted">&copy; 2026 Ghost Security. All rights reserved.</p>
        <p class="font-mono text-[10px] uppercase tracking-[0.1em] text-muted">All vulnerabilities responsibly disclosed.</p>
      </div>
    </div>
  </footer>

  <style>
    .nav-link {
      font-family: var(--font-mono);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #737373;
      padding: 0.25rem 0.75rem;
