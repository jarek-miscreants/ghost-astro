    }
    .nav-link:hover {
      color: #0f0f0f;
    }
    /* Quick Start terminal */
    .qs-tab {
      padding: 4px 12px;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.05em;
      border-radius: 3px;
