    .research-panel.active {
      background: rgba(15, 15, 15, 0.02);
    }
    /* Research panel detail styles */
    .research-panel-badges {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 12px;
    }
    .research-panel-title {
      font-family: var(--font-mono);
      font-size: 18px;
      font-weight: 500;
      letter-spacing: -0.01em;
      margin: 0 0 4px;
    }
    .research-panel-meta {
      font-size: 12px;
