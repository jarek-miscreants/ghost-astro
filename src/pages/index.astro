      line-height: 1.6;
    }
    /* Language bar in panel */
    .lang-row {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 8px;
    }
    .lang-name {
      font-family: var(--font-mono);
      font-size: 12px;
      width: 96px;
      flex-shrink: 0;
    }
    .lang-bar {
      flex: 1;
      height: 1px;
      background: var(--color-border);
      position: relative;
    }
    .lang-fill {
      position: absolute;
      top: -0.5px;
      left: 0;
      height: 2px;
      background: rgba(15, 15, 15, 0.4);
    }
    .lang-count {
