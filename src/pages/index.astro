      background: rgba(244, 63, 94, 0.1);
      border-color: #fda4af;
    }
    .vuln-tag--cmdi {
      color: #881337;
      background: rgba(244, 63, 94, 0.1);
      border-color: #fda4af;
    }
    .vuln-tag--xss {
      color: #4c1d95;
      background: rgba(139, 92, 246, 0.1);
      border-color: #c4b5fd;
    }
    .vuln-tag--auth {
      color: #312e81;
      background: rgba(99, 102, 241, 0.1);
      border-color: #a5b4fc;
    }
    .vuln-tag--toctou {
      color: #134e4a;
      background: rgba(20, 184, 166, 0.1);
      border-color: #5eead4;
    }
    /* Research row hover */
    .research-row:hover,
    .research-row.active {
      background: rgba(15, 15, 15, 0.06);
