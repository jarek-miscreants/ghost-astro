      flex-shrink: 0;
    }
    .qs-cmd {
      color: rgba(255,255,255,0.9);
      flex: 1;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .qs-cmd--green {
      color: rgba(52,211,153,0.9);
    }
    .gs-tool:hover .gs-tool__shader {
      opacity: 0.55 !important;
    }
    #gs-hero-shader canvas,
    #gs-about-left canvas,
    #gs-about-right canvas,
    #gs-cta-shader canvas,
    .gs-tool__shader canvas {
      display: block;
      width: 100%;
      height: 100%;
    }
    #gs-about-left canvas,
    #gs-about-right canvas {
      opacity: 0.06;
      mix-blend-mode: screen;
    }
    #gs-about-text span {
      opacity: 0.12;
      transition: opacity 0.4s;
    }
    /* Vulnerability type tags */
    .vuln-tag {
      display: inline-flex;
