5 92.759 24.635H96.943C96.943 24.635 96.958 24.642 96.958 24.65V28.441C96.958 28.441 96.951 28.456 96.943 28.456H91.976C90.198 28.456 88.804 27.95 87.799 26.936C86.794 25.924 86.289 24.546 86.289 22.806V3.6C86.289 3.6 86.296 3.585 86.304 3.585H90.747C90.747 3.585 90.762 3.592 90.762 3.6V8.561C90.762 8.561 90.769 8.576 90.777 8.576H96.985C96.985 8.576 97 8.583 97 8.591V12.381C97 12.381 96.993 12.397 96.985 12.397H90.774V12.396C90.771 12.398 90.76 12.404 90.76 12.411ZM30.629 12.78L30.631 12.781C30.621 12.786 30.609 12.769 30.609 12.769V8.973C30.609 8.968 30.611 8.961 30.616 8.961C30.824 8.864 31.034 8.773 31.254 8.695C32.297 8.311 33.399 8.113 34.51 8.11C36.34 8.11 37.9 8.495 39.195 9.261C40.468 10.003 41.498 11.1 42.158 12.417C42.838 13.757 43.178 15.281 43.178 16.997V28.443C43.178 28.451 43.163 28.458 43.163 28.458H38.72C38.712 28.458 38.705 28.443 38.705 28.443V17.036C38.705 16.023 38.464 15.132 37.978 14.366C37.512 13.618 36.865 13.001 36.095 12.572C35.392 12.181 34.62 11.968 33.772 11.934C32.923 11.897 32.077 12.06 31.302 12.41C31.069 12.518 30.844 12.641 30.629 12.78ZM28.381 0C28.39 0 28.395 0.015 28.395 0.015V28.44C28.395 28.447 28.38 28.455 28.38 28.455H23.932C23.924 28.455 23.917 28.44 23.917 28.44V0.015C23.917 0.007 23.932 0 23.932 0H28.381Z" fill="black"/></g><defs><clipPath id="clip0_4227_7"><rect width="97" height="39" fill="white"/></clipPath></defs></svg>
      </a>
      <nav class="gs-nav__links">
        <a href="#research" class="gs-nav__link">[R] Research</a>
        <a href="#tools" class="gs-nav__link">[T] Tools</a>
        <a href="#about" class="gs-nav__link">[A] About</a>
        <a href="https://github.com/" target="_blank" rel="noopener noreferrer" class="gs-nav__link">[G] GitHub</a>
      </nav>
      <a href="https://app.ghostsecurity.ai/?t=w" class="gs-nav__link gs-nav__login">[C] Login</a>
      <button class="gs-nav__hamburger" id="gs-nav-toggle" aria-label="Toggle menu">
        <span></span><span></span><span></span>
      </button>
    </div>
    <div class="gs-nav__mobile" id="gs-nav-mobile">
      <a href="#research" class="gs-nav__link">[R] Research</a>
      <a href="#tools" class="gs-nav__link">[T] Tools</a>
      <a href="#about" class="gs-nav__link">[A] About</a>
      <a href="https://github.com/" target="_blank" class="gs-nav__link">[G] GitHub</a>
      <a href="https://app.ghostsecurity.ai/?t=w" class="gs-nav__link">[C] Login</a>
    </div>
  </header>

  <!-- Hero -->
  <div class="gs-hero">
    <div class="gs-hero__shader" id="gs-hero-shader"></div>
    <div class="gs-hero__grad-lr"></div>
    <div class="gs-hero__inner">
      <div class="gs-hero__grid">
        <div>
          <div class="gs-hero__eyebrow">Frontier Security Lab</div>
          <h1 class="gs-hero__title">
            Agentic AppSec Research for <span class="gs-hero__title-accent">All Humankind.</span>
          </h1>
          <p class="gs-hero__desc">
            Ghost Security builds autonomous agents and open source tools
            for security research. We discover, analyze,
            and responsibly disclose vulnerabilities at scale.
          </p>
          <a href="/vulnbench" class="gs-hero__btn">
            View VulnBench Report <span>&rarr;</span>
          </a>
        </div>
        <div class="gs-qs">
          <div class="gs-qs__tabs">
            <span class="gs-qs__tabs-label">Quick Start</span>
            <button class="gs-qs__tab active" data-tab="cli">CLI</button>
            <button class="gs-qs__tab" data-tab="claude-code">Claude Code</button>
            <button class="gs-qs__tab" data-tab="manual">Manual</button>
          </div>
          <div class="gs-qs__panel active" data-panel="cli">
            <div class="gs-qs__section">
              <div class="gs-qs__section-label">Install</div>
              <div class="gs-qs__line"><span class="gs-qs__prompt">$</span><span class="gs-qs__cmd">claude plugin marketplace add ghostsecurity/skills</span></div>
              <div class="gs-qs__line"><span class="gs-qs__prompt">$</span><span class="gs-qs__cmd">claude plugin install ghost@ghost-security</span></div>
            </div>
            <div class="gs-qs__section">
              <div class="gs-qs__section-label">Run</div>
              <div class="gs-qs__line"><span class="gs-qs__prompt">$</span><span class="gs-qs__cmd gs-qs__cmd--green">/ghost-scan-secrets</span></div>
              <div class="gs-qs__line"><span class="gs-qs__prompt">$</span><span class="gs-qs__cmd gs-qs__cmd--green">/ghost-scan-deps</span></div>
              <div class="gs-qs__line"><span class="gs-qs__prompt">$</span><span class="gs-qs__cmd gs-qs__cmd--green">/ghost-scan-code</span></div>
              <div class="gs-qs__line"><span class="gs-qs__prompt">$</span><span class="gs-qs__cmd gs-qs__cmd--green">/ghost-validate</span></div>
            </div>
          </div>
          <div class="gs-qs__panel" data-panel="claude-code">
            <div class="gs-qs__section">
              <div class="gs-qs__section-label">Install</div>
              <div class="gs-qs__line"><span class="gs-qs__prompt">$</span><span class="gs-qs__cmd">/plugin marketplace add ghostsecurity/skills</span></div>
              <div class="gs-qs__line"><span class="gs-qs__prompt">$</span><span class="gs-qs__cmd">/plugin install ghost@ghost-security</span></div>
            </div>
            <div class="gs-qs__section">
              <div class="gs-qs__section-label">Run</div>
              <div class="gs-qs__line"><span class="gs-qs__prompt">$</span><span class="gs-qs__cmd gs-qs__cmd--green">/ghost-scan-secrets</span></div>
              <div class="gs-qs__line"><span class="gs-qs__prompt">$</span><span class="gs-qs__cmd gs-qs__cmd--green">/ghost-scan-deps</span></div>
              <div class="gs-qs__line"><span class="gs-qs__prompt">$</span><span class="gs-qs__cmd gs-qs__cmd--green">/ghost-scan-code</span></div>
              <div class="gs-qs__line"><span class="gs-qs__prompt">$</span><span class="gs-qs__cmd gs-qs__cmd--green">/ghost-validate</span></div>
            </div>
          </div>
          <div class="gs-qs__panel" data-panel="manual">
            <div class="gs-qs__section">
              <div class="gs-qs__section-label">Install</div>
              <div class="gs-qs__line"><span class="gs-qs__prompt">$</span><span class="gs-qs__cmd">git clone https://github.com/ghostsecurity/skills.git ~/.ghost/skills</span></div>
              <div class="gs-qs__line"><span class="gs-qs__prompt">$</span><span class="gs-qs__cmd">claude --plugin-dir ~/.ghost/skills</span></div>
            </div>
            <div class="gs-qs__section">
              <div class="gs-qs__section-label">Run</div>
              <div class="gs-qs__line"><span class="gs-qs__prompt">$</span><span class="gs-qs__cmd gs-qs__cmd--green">/ghost-scan-secrets</span></div>
              <div class="gs-qs__line"><span class="gs-qs__prompt">$</span><span class="gs-qs__cmd gs-qs__cmd--green">/ghost-scan-deps</span></div>
              <div class="gs-qs__line"><span class="gs-qs__prompt">$</span><span class="gs-qs__cmd gs-qs__cmd--green">/ghost-scan-code</span></div>
              <div class="gs-qs__line"><span class="gs-qs__prompt">$</span><span class="gs-qs__cmd gs-qs__cmd--green">/ghost-validate</span></div>
            </div>
          </div>
          <div class="gs-qs__footer">
            <span>Requires Claude Code v2.1.38+</span>
            <a href="#">Full docs &rarr;</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Stats Bar -->
  <div class="gs-stats">
    <div class="gs-stats__inner">
      <div class="gs-stats__item"><div class="gs-stats__value">11+</div><div class="gs-stats__label">CVEs Disclosed</div></div>
      <div class="gs-stats__item"><div class="gs-stats__value">4</div><div class="gs-stats__label">Languages</div></div>
      <div class="gs-stats__item"><div class="gs-stats__value">6</div><div class="gs-stats__label">Vuln Classes</div></div>
      <div class="gs-stats__item"><div class="gs-stats__value">2026</div><div class="gs-stats__label">Since</div></div>
    </div>
  </div>

  <!-- About -->
  <section class="gs-about" id="about">
    <div class="gs-about__edge gs-about__edge--left" id="gs-about-left"></div>
    <div class="gs-about__edge gs-about__edge--right" id="gs-about-right"></div>
    <div class="gs-about__inner">
      <p class="gs-about__text" id="gs-about-text">
        {aboutWords.map(w => <span class="gs-word">{w}</span>).reduce((acc: any[], word, i) => i === 0 ? [word] : [...acc, ' ', word], [])}
      </p>
    </div>
  </section>

  <!-- Tools -->
  <div class="gs-tools" id="tools">
    <div class="gs-tools__inner">
      <div class="gs-tools__header">
        <div>
          <div class="gs-tools__eyebrow">Tools</div>
          <h2 class="gs-tools__title">Agent skills &amp; open source tools.</h2>
        </div>
        <a href="https://github.com/" target="_blank" rel="noopener noreferrer" class="gs-tools__gh">View on GitHub &rarr;</a>
      </div>
      <div class="gs-tools__grid">
        {tools.map((tool) => (
          <div class="gs-tool">
            <div class="gs-tool__banner">
              <div class="gs-tool__shader" id={`gs-shader-${tool.name}`} data-shape={tool.shaderShape} data-color={tool.shaderColor} data-px="2"></div>
              <div class="gs-tool__version">{tool.version}</div>
            </div>
            <div class="gs-tool__body">
              <span class="gs-tool__tag" style={`color:${tool.tagColor}`}>&#9642; {tool.tag}</span>
              <h3 class="gs-tool__name">{tool.name}</h3>
              <p class="gs-tool__desc">{tool.description}</p>
            </div>
            <div class="gs-tool__footer">
              <div class="gs-tool__cmd"><span class="gs-tool__cmd-prompt">&gt;</span><code class="gs-tool__cmd-text">{tool.command}</code></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- CTA Band -->
  <section class="gs-cta">
    <div class="gs-cta__shader" id="gs-cta-shader"></div>
    <div class="gs-cta__inner">
      <div>
        <div class="gs-cta__eyebrow">Benchmark</div>
        <h2 class="gs-cta__title">VulnBench: Measuring AI Security Skill.</h2>
        <p class="gs-cta__desc">Our open research benchmark evaluates how well AI models discover real-world security vulnerabilities across diverse codebases and attack surfaces.</p>
      </div>
      <a href="/vulnbench" class="gs-cta__btn">View Report <span>&rarr;</span></a>
    </div>
  </section>

  <!-- Research -->
  <section class="gs-research" id="research">
    <div class="gs-research__inner">
      <div class="gs-research__header">
        <div class="gs-research__eyebrow">Research</div>
        <h2 class="gs-research__title">Recent vulnerability disclosures.</h2>
        <p class="gs-research__desc">The Ghost Security Research team has discovered and disclosed a number of vulnerabilities using Ghost Security Agent Skills. All findings are responsibly disclosed to maintainers prior to publication.</p>
      </div>
      <div class="gs-research__grid">
        <div class="gs-research__table-col" id="gs-research-table">
          <table>
            <thead>
              <tr>
                <th>Discovered</th>
                <th>Vulnerability</th>
                <th>Type</th>
                <th>Project</th>
                <th>Lang</th>
              </tr>
            </thead>
            <tbody>
              {vulnerabilities.map((vuln) => (
                <tr data-type={vuln.typeClass.replace('gs-research__type--', '')} data-desc={vuln.desc}>
                  <td class="gs-research__date">{vuln.date}</td>
                  <td class="gs-research__id">{vuln.id}</td>
                  <td><span class={`gs-research__type ${vuln.typeClass}`}>{vuln.type}</span></td>
                  <td class="gs-research__project">{vuln.project}</td>
                  <td>{vuln.lang}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="gs-research__panel" id="gs-research-panel">
          <div style="flex:1">
            <div class="gs-research__summary" id="gs-research-summary">
              <div class="gs-research__panel-label">Languages Affected</div>
              {langSorted.map(([name, count]) => (
                <div class="gs-research__lang-row">
                  <span class="gs-research__lang-name" style={`color:${langColors[name] || '#737373'}`}>{name}</span>
                  <div class="gs-research__lang-bar"><div class="gs-research__lang-fill" style={`width:${(count / total * 100).toFixed(0)}%`}></div></div>
                  <span class="gs-research__lang-count">{count}</span>
                </div>
              ))}
            </div>
            <div class="gs-research__detail" id="gs-research-detail">
              <div class="gs-research__panel-badges">
                <span class="gs-research__type" id="gs-detail-type"></span>
                <span class="gs-research__lang-name" id="gs-detail-lang"></span>
              </div>
              <h3 class="gs-research__panel-title" id="gs-detail-id"></h3>
              <p class="gs-research__panel-meta" id="gs-detail-meta"></p>
              <p class="gs-research__panel-desc" id="gs-detail-desc"></p>
            </div>
          </div>
          <div class="gs-research__policy">
            <div class="gs-research__panel-label">Disclosure Policy</div>
            <p class="gs-research__panel-desc">Ghost Security follows a 90-day responsible disclosure policy. All vulnerabilities are privately reported to maintainers and given adequate time for remediation before public disclosure.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="gs-footer">
    <div class="gs-footer__inner">
      <div class="gs-footer__grid">
        <div class="gs-footer__col">
          <div class="gs-footer__heading">Ghost Security</div>
          <div class="gs-footer__subtitle">Frontier Security Lab</div>
        </div>
        <div class="gs-footer__col">
          <div class="gs-footer__heading">Research</div>
          <ul class="gs-footer__list">
            <li><a href="#research">Vulnerability Disclosures</a></li>
            <li><a href="#research">CVE Database</a></li>
            <li><a href="#research">Security Advisories</a></li>
            <li><a href="#research">Research Blog</a></li>
          </ul>
        </div>
