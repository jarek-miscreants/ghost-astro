---
import Layout from '../layouts/Layout.astro';

const tools = [
  {
    name: 'poltergeist',
    tag: 'SECRET SCANNER',
    tagColor: '#1D4ED8',
    version: 'v0.4.2',
    shaderShape: 5,
    shaderColor: '0.114,0.306,0.847,1',
    description: "Ghost Security Agent's secret scanner. Scans source code for leaked API keys, tokens, certificates, and credentials using a dual-engine architecture.",
    command: '/ghost-scan-secrets',
  },
  {
    name: 'wraith',
    tag: 'DEPENDENCY SCANNER',
    tagColor: '#6D28D9',
    version: 'v0.3.1',
    shaderShape: 6,
    shaderColor: '0.427,0.157,0.851,1',
    description: "Ghost Security Agent's dependency scanner. Scans lockfiles for known vulnerabilities using the OSV database, supporting every major package ecosystem.",
    command: '/ghost-scan-deps',
  },
  {
    name: 'reaper',
    tag: 'MITM PROXY',
    tagColor: '#BE123C',
    version: 'v0.2.8',
    shaderShape: 2,
    shaderColor: '0.745,0.071,0.235,1',
    description: "Ghost Security Agent's MITM HTTPS proxy. Intercepts in-scope traffic, stores full request/response pairs in a local SQLite database.",
    command: '/ghost-intercept',
  },
  {
    name: 'exorcist',
    tag: 'CODE ANALYSIS',
    tagColor: '#047857',
    version: 'v0.1.5',
    shaderShape: 4,
    shaderColor: '0.016,0.471,0.341,1',
    description: "Ghost Security Agent's code analysis engine. Reads code like a security engineer: planning attack vectors, tracing data flows.",
    command: '/ghost-analyze',
  },
];

const vulnerabilities = [
  { date: 'Mar. 2026', id: 'GSR-2026-03-004', type: 'BOLA', typeClass: 'gs-research__type--bola', project: '[redacted] community platform', lang: 'Ruby', desc: 'Broken Object Level Authorization \u2014 an attacker can access or modify resources belonging to other users by manipulating object identifiers in API requests.' },
  { date: 'Mar. 2026', id: 'GSR-2026-03-003', type: 'SQL Injection', typeClass: 'gs-research__type--sqli', project: '[redacted] CMS platform', lang: 'Ruby', desc: 'Untrusted input is interpolated directly into SQL queries, allowing an attacker to read, modify, or delete database contents.' },
  { date: 'Mar. 2026', id: 'GSR-2026-03-002', type: 'Command Injection', typeClass: 'gs-research__type--cmdi', project: '[redacted] CMS platform', lang: 'Ruby', desc: 'User-controlled input is passed unsanitized to a system shell, enabling arbitrary command execution on the server.' },
  { date: 'Mar. 2026', id: 'GSR-2026-03-001', type: 'BOLA', typeClass: 'gs-research__type--bola', project: '[redacted] operations platform', lang: 'Python', desc: 'Broken Object Level Authorization \u2014 an attacker can access or modify resources belonging to other users by manipulating object identifiers in API requests.' },
  { date: 'Feb. 2026', id: 'GSR-2026-02-007', type: 'Stored XSS', typeClass: 'gs-research__type--xss', project: '[redacted] CMS platform', lang: 'JavaScript', desc: 'Malicious scripts are persisted in the application\u2019s data store and executed in other users\u2019 browsers when the data is rendered.' },
  { date: 'Feb. 2026', id: 'GSR-2026-02-006', type: 'Auth Session Expiry', typeClass: 'gs-research__type--auth', project: '[redacted] database', lang: 'TypeScript', desc: 'Session tokens remain valid indefinitely or far beyond a reasonable window, increasing the risk of session hijacking.' },
  { date: 'Feb. 2026', id: 'GSR-2026-02-005', type: 'BOLA', typeClass: 'gs-research__type--bola', project: '[redacted] vuln mgmt platform', lang: 'Python', desc: 'Broken Object Level Authorization \u2014 an attacker can access or modify resources belonging to other users by manipulating object identifiers in API requests.' },
  { date: 'Feb. 2026', id: 'GSR-2026-02-004', type: 'BOLA', typeClass: 'gs-research__type--bola', project: '[redacted] vuln mgmt platform', lang: 'Python', desc: 'Broken Object Level Authorization \u2014 an attacker can access or modify resources belonging to other users by manipulating object identifiers in API requests.' },
  { date: 'Feb. 2026', id: 'GSR-2026-02-003', type: 'Command Injection', typeClass: 'gs-research__type--cmdi', project: 'NPM package manager', lang: 'JavaScript', desc: 'User-controlled input is passed unsanitized to a system shell, enabling arbitrary command execution on the server.' },
  { date: 'Feb. 2026', id: 'GSR-2026-02-002', type: 'TOCTOU', typeClass: 'gs-research__type--toctou', project: '[redacted] commerce platform', lang: 'Ruby', desc: 'Time-of-check to time-of-use race condition \u2014 a gap between authorization check and action allows an attacker to exploit the window.' },
  { date: 'Feb. 2026', id: 'GSR-2026-02-001', type: 'TOCTOU', typeClass: 'gs-research__type--toctou', project: '[redacted] commerce platform', lang: 'Ruby', desc: 'Time-of-check to time-of-use race condition \u2014 a gap between authorization check and action allows an attacker to exploit the window.' },
];

const langColors: Record<string, string> = { Ruby: '#be123c', Python: '#1d4ed8', JavaScript: '#b45309', TypeScript: '#0284c7' };

// Compute language counts
const langCounts: Record<string, number> = {};
vulnerabilities.forEach(v => { langCounts[v.lang] = (langCounts[v.lang] || 0) + 1; });
const langSorted = Object.entries(langCounts).sort((a, b) => b[1] - a[1]);
const total = vulnerabilities.length;

const aboutWords = "We're an expert team building autonomous agents at the frontier of security research, finding vulnerabilities at supernatural scale.".split(/\s+/);
---

<Layout>
  <!-- Navigation -->
  <header class="gs-nav">
    <div class="gs-nav__inner">
      <a href="#" class="gs-nav__pill">
        <svg width="97" height="39" viewBox="0 0 97 39" fill="none" xmlns="http://www.w3.org/2000/svg" style="height:24px;width:auto"><g clip-path="url(#clip0_4227_7)"><path d="M17.22 18.387V18.013C17.22 15.874 16.622 14.234 15.42 13.096C14.22 11.928 12.612 11.346 10.77 11.346C8.92798 11.346 7.39198 11.928 6.16198 13.096C4.96298 14.234 4.36198 15.873 4.36198 18.013V18.387C4.36198 20.469 4.95998 22.109 6.16198 23.303C7.39098 24.471 8.89798 25.053 10.77 25.053C12.642 25.053 14.176 24.471 15.378 23.303C16.607 22.11 17.22 20.47 17.22 18.387ZM21.451 30.788C21.449 33.812 19.782 36.59 17.115 38.015C13.758 39.817 9.60598 39.099 7.04898 36.275L6.54698 35.719C4.98198 33.993 2.42898 33.583 0.401977 34.733L0.0219766 34.949C0.0219766 34.949 0.000976562 34.949 0.000976562 34.937V30.28C0.000976562 30.28 0.00597656 30.268 0.0109766 30.265C3.47798 29.144 7.28098 30.16 9.72598 32.862L10.186 33.372C11.307 34.614 13.09 35.076 14.65 34.459C16.167 33.873 17.166 32.412 17.161 30.786V26.846C17.161 26.84 17.158 26.835 17.152 26.833C17.147 26.831 17.141 26.832 17.137 26.836C17.047 26.903 16.952 26.962 16.853 27.014C15.095 28.016 13.132 28.606 11.113 28.738C10.541 28.776 10.003 28.801 9.59098 28.801C7.90898 28.813 6.25098 28.396 4.77398 27.591C3.32098 26.76 2.16398 25.577 1.29598 24.051C0.435977 22.496 0.00197656 20.651 0.00197656 18.511V17.888C0.00197656 15.722 0.435977 13.874 1.29998 12.348C2.19398 10.82 3.36598 9.638 4.81998 8.806C5.34798 8.503 6.12698 8.252 6.89998 8.062C8.68298 7.622 10.536 7.549 12.348 7.849L12.412 7.859C14.105 8.135 15.728 8.737 17.192 9.631C17.212 9.643 17.229 9.653 17.239 9.661C17.249 9.665 17.261 9.661 17.261 9.648V8.156C17.261 8.156 17.268 8.141 17.276 8.141H21.436C21.436 8.141 21.451 8.148 21.451 8.156V30.788ZM68.301 24.65C68.301 24.65 68.308 24.635 68.316 24.635H77.951C78.421 24.635 78.833 24.532 79.187 24.324C79.539 24.116 79.814 23.841 80.009 23.507C80.206 23.169 80.302 22.819 80.302 22.454C80.302 22.038 80.208 21.674 80.029 21.363C79.839 21.044 79.567 20.781 7